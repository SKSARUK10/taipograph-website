# Copy to .env and fill in.
PORT=5000
NODE_ENV=development

# Local MongoDB, or an Atlas URI such as mongodb+srv://user:pass@cluster.mongodb.net/taipograph
MONGODB_URI=mongodb://127.0.0.1:27017/taipograph

# Origins allowed to call the API from a browser (comma separated).
# Only needed if the client is hosted on a different origin than the API.
CLIENT_ORIGIN=http://localhost:5173

# Upload limits (MB). Keep VITE_UPLOAD_MAX_MB in client/.env the same.
UPLOAD_MAX_MB=25

# Set to 1 when behind a proxy/load balancer (Render, Railway, Nginx...) so rate limiting sees real client IPs.
TRUST_PROXY=0
