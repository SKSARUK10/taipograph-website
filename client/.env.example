# Base URL of the API. Leave as /api when the Express server serves the built client
# (or when using the Vite dev proxy). Set a full URL if the API is hosted separately.
VITE_API_URL=/api

# Frontend email notification via EmailJS (https://www.emailjs.com). Optional.
# Leave blank to disable; the form will then rely on the database save (and mailto fallback if the API is down).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Must match the server limits (UPLOAD_MAX_MB) for friendly client-side validation.
VITE_UPLOAD_MAX_MB=25

# WhatsApp click-to-chat number: country code + number, digits only (e.g. 918479050435). Defaults to the site phone number.
VITE_WHATSAPP_NUMBER=
